cabal-version:   3.12
name:            http-server
version:         0.1.0.0
license:         NONE
author:          venkatkumar.al22
maintainer:      venkatkumar.al22@bitsathy.ac.in
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
  ghc-options: -Wall

executable http-server
  import:           warnings
  main-is:          Main.hs
  other-modules:
    Utils.ReadCloser
    Types.Utils.ReadCloser
  build-depends:    
    base ^>=4.18.3.0,
    bytestring
  hs-source-dirs:   app, src
  default-language: Haskell2010
